```html
<!doctype html>
<html>
<head>
<meta charset="utf-8"/>
<title>Admin posten</title>
<style>
body{font-family:Arial;max-width:700px;margin:20px auto;padding:0 10px;}
input,textarea{width:100%;padding:10px;margin:6px 0;box-sizing:border-box;}
button{padding:10px 12px;background:#222;color:#fff;border:0;border-radius:6px;cursor:pointer;}
</style>
</head>
<body>
<p><a href="/">← Terug</a> | <a href="/admin/logout">Logout</a></p>
<h1>Nieuwe post</h1>

<form method="POST" action="/admin/post" enctype="multipart/form-data">
<input name="title" placeholder="Titel" />
<textarea name="content" rows="6" placeholder="Tekst..."></textarea>

<p>Foto (optioneel):</p>
<input type="file" name="image" accept="image/*" />

<button type="submit">Plaats post</button>
</form>
</body>
</html>
