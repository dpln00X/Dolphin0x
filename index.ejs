```html
<!doctype html>
<html>
<head>
<meta charset="utf-8"/>
<title>Forum</title>
<style>
body{font-family:Arial;max-width:900px;margin:20px auto;padding:0 10px;}
.post{border:1px solid #ddd;padding:14px;border-radius:8px;margin:10px 0;}
img{max-width:100%;height:auto;border-radius:8px;}
.btn{display:inline-block;padding:8px 12px;background:#222;color:#fff;text-decoration:none;border-radius:6px;}
textarea,input{width:100%;padding:10px;margin:6px 0;box-sizing:border-box;}
</style>
</head>
<body>
<h1>Forum</h1>
<a class="btn" href="/admin/login">Admin</a>

<% posts.forEach(p => { %>
<div class="post">
<h2><a href="/post/<%= p.id %>"><%= p.title %></a></h2>
<p><%= p.content %></p>
<% if (p.image_path) { %>
<img src="<%= p.image_path %>"/>
<% } %>
<small><%= p.created_at %></small>
</div>
<% }) %>
</body>
</html>
```